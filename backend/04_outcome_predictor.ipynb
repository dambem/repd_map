    "    cols = X_perm[:, idxs]\n",
    "    rng.shuffle(cols)\n",
    "    X_perm[:, idxs] = cols\n",
    "    perm_acc = accuracy_score(y_test, mlp.predict(X_perm))\n",
    "    importance[name] = base_acc - perm_acc\n",
